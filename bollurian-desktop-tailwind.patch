+  brand: string;
+}
+
+export interface QuoteSummary {
+  rows: QuoteRow[];
+  enabledRows: QuoteRow[];
+  incompleteRows: QuoteRow[];
+  total: number;
+}
+
+export type LoadStatus = "loading" | "ready" | "error";
