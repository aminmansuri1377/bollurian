{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bollourian Elevator",
  "version": "0.2.0",
  "identifier": "ir.bollourian.elevator",
  "build": {
    "beforeDevCommand": "npm run icons:generate && npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run icons:generate && npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Bollourian | Elevator Price Manager",
        "width": 1240,
        "height": 850,
        "minWidth": 1170,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
