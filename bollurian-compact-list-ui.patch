@@ -0,0 +1,24 @@
+import type { QuoteRow } from "@/lib/price-manager/types";
+import { RowNumberBadge } from "./row-number-badge";
+
+interface ProductNameCellProps {
+  row: QuoteRow;
+  rowNumber: number;
+  /** Dense list layout: shorter row, smaller badge. */
+  compact?: boolean;
+}
+
+/** Single-model products: same look as the brand menu, but nothing happens on click. */
+export function ProductNameCell({ row, rowNumber, compact = false }: ProductNameCellProps) {
+  const { product, enabled } = row;
+  return (
+    <div
+      data-inactive={!enabled}
+      title={product.name}
+      className={`relative flex w-full min-w-0 items-center rounded-full border border-brand bg-white text-right data-[inactive=true]:opacity-45 ${compact ? "h-[34px] pr-[34px]" : "h-[50px] pr-[50px]"}`}
+    >
+      <RowNumberBadge value={rowNumber} size={compact ? "compact" : "screen"} className="absolute -top-px -right-px" />
+      <span className="min-w-0 flex-1 truncate px-3 text-[13px] font-light">{product.name}</span>
+    </div>
+  );
+}
